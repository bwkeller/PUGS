# Settings for the production NUGS2048 volume.  Each may be overridden by
# exporting it before sourcing this file.
export PUGS_SIMULATION=${PUGS_SIMULATION:-$HOME/data/NUGS2048}
export PUGS_NAME=${PUGS_NAME:-NUGS2048}
export PUGS_CATALOG=${PUGS_CATALOG:-$HOME/NUGS2048_catalog}
export PUGS_MIN_PARTICLES=${PUGS_MIN_PARTICLES:-500}
# Set to 1 to also store the particle-id shells for the z=0 halos.
export PUGS_PARTICLE_IDS=${PUGS_PARTICLE_IDS:-}
