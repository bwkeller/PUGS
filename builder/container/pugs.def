Bootstrap: docker
From: python:3.13-bookworm

# The build_container.sh wrapper stages the bundled Parquet halo catalog at
# _catalog.staged before invoking `apptainer build`. The real catalog is
# expected to be supplied via `./build_container.sh -c /path/to/catalog`;
# if no path is supplied the wrapper stages catalog.placeholder so the
# container builds end-to-end even before the 2048^3 catalog is ready.

%files
    _catalog.staged                                /opt/PUGS/data/catalog
    ../../pugs                                     /opt/PUGS/pugs
    ../../inputs                                   /opt/PUGS/inputs
    ../../pyproject.toml                           /opt/PUGS/pyproject.toml
    ../../README.md                                /opt/PUGS/README.md
    ../../builder/volume_ic/build.sh               /opt/PUGS/builder/volume_ic/build.sh
    ../../builder/volume_ic/fix_header.py          /opt/PUGS/builder/volume_ic/fix_header.py
    ../../builder/volume_ic/.checksums.txt         /opt/PUGS/builder/volume_ic/.checksums.txt
    ../../builder/catalog/build_catalog.sh         /opt/PUGS/builder/catalog/build_catalog.sh
    ../../builder/catalog/test_vars                /opt/PUGS/builder/catalog/test_vars

%post
    set -eux

    # The version of genetIC that the bundled halo catalog was generated with.
    # Bump this in lockstep with the Docker tag used by builder/volume_ic/build.sh.
    GENETIC_VERSION="v1.5.0"

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        gfortran \
        git \
        libfftw3-dev \
        libgsl-dev \
        libhdf5-dev \
        pkg-config \
        wget
    rm -rf /var/lib/apt/lists/*

    # Build GenetIC from source against the system FFTW/GSL.
    git clone --recurse-submodules --branch "${GENETIC_VERSION}" \
        https://github.com/pynbody/genetIC.git /opt/genetIC
    make -C /opt/genetIC/genetIC -j "$(nproc)"
    install -m 0755 /opt/genetIC/genetIC/genetIC /usr/local/bin/genetIC

    # Install the PUGS package and its scientific Python stack.
    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir /opt/PUGS[dev]

    # Mount points for runtime-supplied data.
    mkdir -p /data/sims /data/zoom_ics

    # The build_container.sh wrapper guarantees this directory is present, but
    # we check here so a hand-driven `apptainer build` fails loudly rather than
    # producing a container with a missing catalog.
    test -d /opt/PUGS/data/catalog

%environment
    export PUGS_CATALOG=/opt/PUGS/data/catalog
    export PUGS_SIMULATION=/data/sims
    export PUGS_HOME=/opt/PUGS
    export PYTHONUNBUFFERED=1

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    else
        exec "$@"
    fi

%labels
    Author      BW Keller <bkeller1@memphis.edu>
    Project     PUGS: Portable Universal Galaxy Sampler
    Source      https://github.com/bwkeller/PUGS

%help
    PUGS - Portable Universal Galaxy Sampler

    This container bundles the PUGS pipeline together with the pre-computed
    Parquet halo catalog from the 2048^3 collisionless volume:

      genetIC                      cosmological zoom-in IC generator
      pugs (Python package)        catalog builder and zoom helpers
      /opt/PUGS/data/catalog       pre-computed Parquet halo catalog

    Quick start:

        # Drop into an interactive shell with the environment configured
        apptainer run pugs.sif

        # Inspect the bundled halo catalog
        apptainer exec pugs.sif python -c \
            "from pugs.io import read_catalog; import os; \
             c = read_catalog(os.environ['PUGS_CATALOG']); \
             print(len(c), 'halos', c.provenance['simulation'])"

        # Or query it with any Parquet reader, no PUGS import needed
        apptainer exec pugs.sif python -c \
            "import duckdb, os; print(duckdb.sql( \
             f\"select count(*) from '{os.environ['PUGS_CATALOG']}/halos_*.parquet'\"))"

        # Generate a zoom-in IC for a halo (writes id_file.txt)
        apptainer exec -B /path/to/sims:/data/sims pugs.sif python -c \
            "from pugs.genetic import write_particle_ids; \
             write_particle_ids('/data/sims/NUGS2048', HALO_ID)"

    To build a catalog from snapshots living on the host filesystem,
    bind-mount them to /data/sims:

        apptainer exec -B /path/to/sims:/data/sims pugs.sif \
            python -m pugs.export /data/sims/NUGS2048 -o /data/catalog

    Environment variables (already set inside the container):
        PUGS_CATALOG=/opt/PUGS/data/catalog
        PUGS_SIMULATION=/data/sims
        PUGS_HOME=/opt/PUGS
